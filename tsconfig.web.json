{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/renderer/src", "src/shared", "src/sandbox/draw-host.ts", "src/sandbox/svg-clean.ts"],
  "exclude": ["src/**/*.test.ts"]
}
