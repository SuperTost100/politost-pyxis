{
  "name": "politost-pyxis",
  "version": "0.1.0",
  "description": "PoliTost Pyxis is a free, open-source study tutor that runs on the student's computer.",
  "author": "PoliTost",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node scripts/test-electron.mjs",
    "test:e2e": "npm run build && playwright test",
    "shoot": "npm run build && tsx scripts/shoot.ts",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ant-design/pro-components": "^3.1.15-3",
    "@tanstack/react-query": "^5.104.0",
    "antd": "^6.6.5",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
