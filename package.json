{
  "name": "politost-pyxis",
  "version": "0.1.1",
  "description": "PoliTost Pyxis is a free, open-source study tutor that runs on the student's computer.",
  "author": "PoliTost",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node scripts/test-electron.mjs",
    "test:e2e": "npm run build && playwright test",
    "shoot": "npm run build && tsx scripts/shoot.ts",
    "shoot:readme": "npm run build && tsx scripts/readme-shots.ts",
    "dist": "npm run build && node scripts/package.mjs",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "notices": "node scripts/gen-notices.mjs",
    "prebuild": "npm run notices",
    "predev": "npm run notices",
    "test:fixtures": "tsx scripts/prepare-fixtures.ts"
  },
  "dependencies": {
    "@ant-design/pro-components": "3.1.15-3",
