    "@huggingface/transformers": "^3.8.1",
    "@mozilla/readability": "^0.6.0",
    "@politost/content-core": "file:vendor/politost-content-core-0.2.0.tgz",
    "@tanstack/react-query": "^5.104.0",
    "@xyflow/react": "^12.12.0",
    "antd": "^6.6.5",
    "better-sqlite3": "^13.0.3",
    "cli-funnel": "file:vendor/cli-funnel-0.2.0.tgz",
    "d3-hierarchy": "^3.1.2",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.2",
    "html-to-image": "1.11.11",
    "i18next": "^26.4.2",
    "jpeg-js": "^0.4.4",
    "katex": "0.16.22",
    "libheif-js": "1.23.2",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^4.10.38",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "10.1.0",
